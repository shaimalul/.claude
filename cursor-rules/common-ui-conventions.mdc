  - input: |
      What standards should I follow when creating a Common UI component?
    output: |
      When creating a Common UI component:
      
      ✅ Name the component with the ZCD prefix:
      ```tsx
      export function ZCDButton({ children, onClick, variant = 'primary' }) {
        // Component implementation
      }
      ```
      
      ✅ Use CSS modules with the .module.scss extension:
      ```
      ZCDButton/
        ├── ZCDButton.tsx
        ├── ZCDButton.module.scss
        └── ZCDButton.stories.tsx
      ```
      
      ✅ Add the className prop to the root element:
      ```tsx
      return (
        <button
          className={classNames(
            styles.button,
            styles[variant],
            className // User-provided className
          )}
          onClick={onClick}
        >
          {children}
        </button>
      );
      ```
      
      ✅ Control all styling through props (not style prop):
      ```tsx
      // Good: Variant controlled through props
      <ZCDButton variant="primary" size="medium" />
      
      // Avoid: Direct styling
      <ZCDButton style={{ backgroundColor: 'blue' }} />
      ```
      
      ✅ Create stories using the storybook conventions:
      ```
      # Follow the storybook-conventions.mdc guidelines for comprehensive stories
      ```
      
      ✅ Export from src/ZCD/index.ts:
      ```ts
      // src/ZCD/index.ts
      export { ZCDButton } from './ZCDButton/ZCDButton';
      ```

  - input: |
      How should I create a new React hook for the Common UI library?
    output: |
      To create a new React hook for the Common UI library:
      
      1. **Check for existing hooks first**:
         Look in `src/hooks` to ensure similar functionality doesn't already exist
      
      2. **Create the hook file with TypeScript**:
         ```typescript
         // src/hooks/useToggle.ts
         
         /**
          * A hook for managing toggle state with TypeScript support
          * 
          * @param initialState - Initial toggle state (default: false)
          * @returns Object containing current state and toggle functions
          * 
          * @example
          * const { state, toggle, setOn, setOff } = useToggle(true);
          */
         export function useToggle(initialState = false): UseToggleReturn {
           const [state, setState] = useState<boolean>(initialState);
           
           const toggle = useCallback(() => setState(s => !s), []);
           const setOn = useCallback(() => setState(true), []);
           const setOff = useCallback(() => setState(false), []);
           
           return { state, toggle, setOn, setOff };
         }
         
         export interface UseToggleReturn {
           state: boolean;
           toggle: () => void;
           setOn: () => void;
           setOff: () => void;
         }
         ```
      
      3. **Create comprehensive unit tests**:
         ```typescript
         // src/hooks/useToggle.test.ts
         import { renderHook, act } from '@testing-library/react-hooks';
         import { useToggle } from './useToggle';
         
         describe('useToggle', () => {
           it('should initialize with default state', () => {
             const { result } = renderHook(() => useToggle());
             expect(result.current.state).toBe(false);
           });
           
           it('should initialize with provided state', () => {
             const { result } = renderHook(() => useToggle(true));
             expect(result.current.state).toBe(true);
           });
           
           it('should toggle state', () => {
             const { result } = renderHook(() => useToggle(false));
             act(() => {
               result.current.toggle();
             });
             expect(result.current.state).toBe(true);
           });
           
           // More tests for setOn and setOff
         });
         ```
      
      4. **Create a Storybook story with play functions**:
         ```typescript
         // src/hooks/useToggle.stories.tsx
         import { Meta, StoryObj } from '@storybook/react';
         import { expect, within, userEvent } from '@storybook/test';
         import React from 'react';
         import { StorybookPage } from '../StorybookComponents/StorybookPage/StorybookPage';
         import { useToggle } from './useToggle';
         
         function ToggleDemo() {
           const { state, toggle, setOn, setOff } = useToggle(false);
           
           return (
             <div>
               <p>Current state: {state ? 'ON' : 'OFF'}</p>
               <button onClick={toggle}>Toggle</button>
               <button onClick={setOn}>Set ON</button>
               <button onClick={setOff}>Set OFF</button>
             </div>
           );
         }
         
         const meta: Meta = {
           title: "HOOKS/Toggle",
           component: ToggleDemo,
         };
         
         export default meta;
         
         type Story = StoryObj;
         
         const Template: Story = {
           render: () => (
             <StorybookPage title="useToggle" description="A hook for managing toggle state">
               <ToggleDemo />
             </StorybookPage>
           ),
         };
         
         export const Default: Story = {
           ...Template,
           play: async ({ canvasElement }) => {
             const canvas = within(canvasElement);
             
             // Initial state
             let stateText = canvas.getByText(/current state/i);
             await expect(stateText).toHaveTextContent('OFF');
             
             // Toggle
             const toggleButton = canvas.getByText('Toggle');
             await userEvent.click(toggleButton);
             await expect(stateText).toHaveTextContent('ON');
             
             // Set OFF
             const offButton = canvas.getByText('Set OFF');
             await userEvent.click(offButton);
             await expect(stateText).toHaveTextContent('OFF');
           },
         };
         ```
      
      5. **Export your hook**:
         ```typescript
         // src/index.ts
         export { useToggle } from './hooks/useToggle';
         ```
      
      Remember to verify all tests pass with `npm run test-storybook` and `npm run lint` before considering the hook complete!

  - input: |
      What's the difference between when I should create a hook versus a component?
    output: |
      ## Hook vs. Component: When to Use Each
      
      ### Use a Hook When:
      
      ✅ You're handling stateful logic without UI
      ```tsx
      // Good hook candidate - manages form state without UI
      function useFormField(initialValue = '') {
        const [value, setValue] = useState(initialValue);
        const [error, setError] = useState('');
        
        const validate = (validator) => {
          const result = validator(value);
          setError(result.error || '');
          return result.isValid;
        };
        
        return { value, setValue, error, validate };
      }
      ```
      
      ✅ The functionality can be reused across multiple components
      ```tsx
      // Reusable logic for any component needing media queries
      function useMediaQuery(query) {
        const [matches, setMatches] = useState(window.matchMedia(query).matches);
        
        useEffect(() => {
          const media = window.matchMedia(query);
          const updateMatch = (e) => setMatches(e.matches);
          
          media.addEventListener('change', updateMatch);
          return () => media.removeEventListener('change', updateMatch);
        }, [query]);
        
        return matches;
      }
      ```
      
      ✅ You're managing side effects, lifecycle, or stateful logic
      ```tsx
      // Managing browser API and event listeners
      function useOnlineStatus() {
        const [isOnline, setIsOnline] = useState(navigator.onLine);
        
        useEffect(() => {
          const handleOnline = () => setIsOnline(true);
          const handleOffline = () => setIsOnline(false);
          
          window.addEventListener('online', handleOnline);
          window.addEventListener('offline', handleOffline);
          
          return () => {
            window.removeEventListener('online', handleOnline);
            window.removeEventListener('offline', handleOffline);
          };
        }, []);
        
        return isOnline;
      }
      ```
      
      ### Use a Component When:
      
      ✅ The feature includes visual UI elements
      ```tsx
      // Better as a component since it's primarily UI
      function ZCDToggleSwitch({ isOn, onToggle, label }) {
        return (
          <div className={styles.toggleContainer}>
            <span className={styles.label}>{label}</span>
            <button 
              className={`${styles.switch} ${isOn ? styles.on : ''}`}
              onClick={onToggle}
              aria-pressed={isOn}
            >
              <span className={styles.thumb} />
            </button>
          </div>
        );
      }
      ```
      
      ✅ You're combining multiple hooks with UI rendering
      ```tsx
      // Better as a component - combines hooks with UI
      function ZCDAutocomplete({ options, onChange }) {
        const [query, setQuery] = useState('');
        const [isOpen, setIsOpen] = useState(false);
        const filteredOptions = useFilteredOptions(options, query);
        const ref = useClickOutside(() => setIsOpen(false));
        
        return (
          <div ref={ref} className={styles.autocomplete}>
            <input 
              value={query}
              onChange={(e) => setQuery(e.target.value)}
              onFocus={() => setIsOpen(true)}
            />
            {isOpen && (
              <ul className={styles.options}>
                {filteredOptions.map(option => (
                  <li key={option.id} onClick={() => onChange(option)}>
                    {option.label}
                  </li>
                ))}
              </ul>
            )}
          </div>
        );
      }
      ```
      
      ✅ When the structure is primarily presentational
      ```tsx
      // Better as a component - primarily presentational
      function ZCDInfoPanel({ title, children }) {
        return (
          <div className={styles.panel}>
            <h3 className={styles.title}>{title}</h3>
            <div className={styles.content}>
              {children}
            </div>
          </div>
        );
      }
      ```

