  }
  ```

  ✅ Interfaces: Use PascalCase, no "I" prefix

  ```tsx
  interface User {
    id: string;
    username: string;
    email: string;
    role: UserRole;
  }

  interface ApiResponse<T> {
    data: T;
    status: HttpStatusCode;
    message: string;
  }
  ```

  ❌ Don't use lowercase for constants
  ❌ Don't use mixed case for enum keys
  ❌ Don't use "I" prefix for interfaces

- input: |
  How should I handle different shape types in TypeScript?
  output: |
  For handling different shape types in TypeScript:
  ✅ Use discriminated unions instead of optional fields:

  ```tsx
  // Good: Use discriminated union
  type Circle = {
    kind: 'circle';
    radius: number;
  };

  type Rectangle = {
    kind: 'rectangle';
    width: number;
    height: number;
  };

  type Shape = Circle | Rectangle;

  // Usage with type safety
  function calculateArea(shape: Shape): number {
    switch (shape.kind) {
      case 'circle':
        return Math.PI * shape.radius * shape.radius;
      case 'rectangle':
        return shape.width * shape.height;
    }
  }
  ```

  ❌ Avoid optional fields for discrimination:

  ```tsx
  // Bad: Using optional fields
  type Shape = {
    radius?: number; // Optional for rectangle
    width?: number; // Optional for circle
    height?: number; // Optional for circle
  };

  // Less type-safe usage
  function calculateArea(shape: Shape): number {
    if (shape.radius !== undefined) {
      return Math.PI * shape.radius * shape.radius;
    } else if (shape.width !== undefined && shape.height !== undefined) {
      return shape.width * shape.height;
    }
    throw new Error('Invalid shape');
  }
  ```

