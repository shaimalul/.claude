{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__chrome-devtools__*",
      "mcp__playwright__*",
      "Read(**)",
      "Write(**)",
      "Edit(**)",
      "Bash",
      "WebSearch",
      "mcp__notion__notion-fetch",
      "mcp__notion__notion-search",
      "mcp__notion__notion-move-pages",
      "mcp__claude_ai_Jira__getJiraIssue",
      "mcp__claude_ai_Jira__searchJiraIssuesUsingJql",
      "mcp__claude_ai_Jira__createJiraIssue",
      "mcp__claude_ai_Jira__updateJiraIssue",
      "mcp__claude_ai_Jira__deleteJiraIssue",
      "mcp__claude_ai_Jira__getJiraIssueComments",
      "mcp__claude_ai_Jira__addJiraIssueComment",
      "mcp__claude_ai_Jira__updateJiraIssueComment",
      "mcp__claude_ai_Jira__deleteJiraIssueComment",
      "mcp__claude_ai_Jira__getJiraIssueAttachments"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-sonnet-4-6",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/shaimalul/.claude/scripts/hooks/session-start.js",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/shaimalul/.claude/scripts/hooks/session-end.js",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Submarine.aiff",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/shaimalul/.claude/scripts/hooks/micro-iterate-stop-hook.js",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/shaimalul/.claude/scripts/hooks/evaluate-session.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/shaimalul/.claude/scripts/hooks/evaluate-cleanup.js",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/shaimalul/.claude/plugins/claude-notifier-plugin/scripts/notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/shaimalul/.claude/plugins/claude-notifier-plugin/scripts/notify.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/shaimalul/.claude/scripts/hooks/suggest-compact.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/shaimalul/.claude/scripts/hooks/git-guardrails.js",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "babysitter@a5c.ai": true
  },
  "alwaysThinkingEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "feedbackSurveyState": {
    "lastShownTime": 1753951833330
  }
}
